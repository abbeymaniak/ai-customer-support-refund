# Database Configuration
POSTGRES_USER=refunds_user
POSTGRES_PASSWORD=refunds_pass
POSTGRES_DB=refunds_db
DATABASE_URL=postgresql+asyncpg://refunds_user:refunds_pass@postgres:5432/refunds_db

# AI / LLM Configuration (LiteLLM)
# Primary provider (e.g., openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-20241022, gemini/gemini-1.5-flash)
LLM_PROVIDER=openai/gpt-4o-mini

# Fallback provider if primary fails or times out
LLM_FALLBACK_PROVIDER=ollama/llama3

# API Keys & URLs
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_API_BASE=http://localhost:11434

# Application Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
LOG_LEVEL=INFO
